import React, { useState, useEffect, useRef } from 'react';
import { Send, LogIn, User, RefreshCw, AlertCircle, Info } from 'lucide-react';

/**
 * Bluesky LINE-Style Client (Web Prototype)
 * Fixed: Robust SDK loading and detailed error reporting.
 */

export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [handle, setHandle] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [feed, setFeed] = useState([]);
  const [inputText, setInputText] = useState('');
  const [refreshing, setRefreshing] = useState(false);
  const [agent, setAgent] = useState(null);
  const [error, setError] = useState(null);
  const [sdkStatus, setSdkStatus] = useState('loading');

  const scrollRef = useRef(null);

  // --- Load Bluesky SDK ---
  useEffect(() => {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@atproto/api@0.13.16/dist/index.global.js';
    script.async = true;
    script.onload = () => {
      try {
        if (window.atproto && window.atproto.BskyAgent) {
          const newAgent = new window.atproto.BskyAgent({ service: 'https://bsky.social' });
          setAgent(newAgent);
          setSdkStatus('ready');
        } else {
          setSdkStatus('error');
          setError("SDKの初期化に失敗しました。");
        }
      } catch (e) {
        setSdkStatus('error');
        setError("SDK読み込みエラー: " + e.message);
      }
    };
    script.onerror = () => {
      setSdkStatus('error');
      setError("ネットワークエラーによりSDKを読み込めませんでした。");
    };
    document.body.appendChild(script);
  }, []);

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [feed]);

  // --- Handlers ---
  const handleLogin = async (e) => {
    e.preventDefault();
    if (!handle || !password || !agent) return;
    
    setLoading(true);
    setError(null);
    
    try {
      // Handle check (add .bsky.social if missing)
      let fullHandle = handle;
      if (!handle.includes('.')) {
        fullHandle = `${handle}.bsky.social`;
      }

      await agent.login({ identifier: fullHandle, password });
      setIsLoggedIn(true);
      fetchTimeline();
    } catch (e) {
      console.error("Login Error:", e);
      if (e.message.includes('CORS')) {
        setError("通信エラー: ブラウザのセキュリティ制限によりログインできません。");
      } else {
        setError("ログイン失敗: ハンドル名またはアプリパスワードが正しくありません。");
      }
    } finally {
      setLoading(false);
    }
  };

  const fetchTimeline = async () => {
    if (!agent) return;
    setRefreshing(true);
    try {
      const response = await agent.getTimeline({ limit: 40 });
      const posts = response.data.feed.map(item => ({
        id: item.post.cid,
        author: item.post.author.displayName || item.post.author.handle,
        handle: item.post.author.handle,
        avatar: item.post.author.avatar,
        text: item.post.record.text,
        createdAt: item.post.record.createdAt,
        isMe: item.post.author.handle === agent.session?.handle,
      }));
      setFeed(posts.reverse());
    } catch (e) {
      console.error(e);
      setError("タイムラインの取得に失敗しました。");
    } finally {
      setRefreshing(false);
    }
  };

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!inputText.trim() || !agent) return;

    const textToPost = inputText;
    setInputText('');

    try {
      await agent.post({
        text: textToPost,
        createdAt: new Date().toISOString(),
      });
      fetchTimeline();
    } catch (e) {
      setError("送信失敗: " + e.message);
      setInputText(textToPost);
    }
  };

  // --- UI ---
  if (!isLoggedIn) {
    return (
      <div className="flex flex-col items-center justify-center min-h-screen bg-white p-6 font-sans text-black">
        <div className="w-full max-w-md space-y-6">
          <div className="text-center">
            <div className="mx-auto h-16 w-16 bg-[#00C300] rounded-2xl flex items-center justify-center shadow-lg mb-4">
              <span className="text-white text-3xl font-bold italic">B</span>
            </div>
            <h2 className="text-2xl font-bold text-gray-900 tracking-tight">Bluesky LINE Client</h2>
            <p className="mt-1 text-xs text-gray-500">トーク形式で楽しむBluesky</p>
          </div>

          <div className="bg-blue-50 p-4 rounded-xl flex items-start space-x-3 border border-blue-100">
            <Info size={18} className="text-blue-500 mt-0.5 flex-shrink-0" />
            <div className="text-[11px] text-blue-800 leading-relaxed">
              <strong>ログイン方法:</strong><br />
              1. Blueskyアプリで「アプリパスワード」を作成してください。<br />
              2. ハンドル名（example.bsky.social）と作成したパスワードを入力します。
            </div>
          </div>

          <form className="space-y-4" onSubmit={handleLogin}>
            <div className="space-y-1">
              <label className="text-[10px] font-bold text-gray-400 ml-1">HANDLE</label>
              <input
                type="text"
                required
                className="block w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00C300] focus:bg-white transition-all text-sm"
                placeholder="example.bsky.social"
                value={handle}
                onChange={(e) => setHandle(e.target.value)}
              />
            </div>
            <div className="space-y-1">
              <label className="text-[10px] font-bold text-gray-400 ml-1">APP PASSWORD</label>
              <input
                type="password"
                required
                className="block w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#00C300] focus:bg-white transition-all text-sm"
                placeholder="abcd-1234-efgh-5678"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
              />
            </div>

            {error && (
              <div className="flex items-center p-3 bg-red-50 text-red-600 rounded-lg text-xs animate-pulse">
                <AlertCircle size={14} className="mr-2 flex-shrink-0" />
                {error}
              </div>
            )}

            <button
              type="submit"
              disabled={loading || sdkStatus !== 'ready'}
              className="w-full flex justify-center py-4 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-[#00C300] hover:bg-[#00b200] focus:outline-none focus:ring-4 focus:ring-[#00C300]/30 transition-all disabled:bg-gray-300 shadow-md"
            >
              {loading ? (
                <div className="flex items-center">
                  <RefreshCw className="animate-spin mr-2" size={18} />
                  ログイン中...
                </div>
              ) : (
                "ログイン"
              )}
            </button>
          </form>
          
          <div className="text-center">
            <span className="text-[10px] text-gray-400">
              {sdkStatus === 'loading' ? 'SDKを読み込んでいます...' : 'SDK準備完了'}
            </span>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="flex flex-col h-screen max-w-lg mx-auto bg-[#7494C0] shadow-2xl overflow-hidden font-sans">
      {/* Header */}
      <header className="flex items-center justify-between px-4 py-3 bg-[#7494C0] border-b border-black/5 text-white shadow-sm z-20">
        <div className="flex items-center space-x-3">
          <div className="w-9 h-9 rounded-2xl bg-white/10 flex items-center justify-center border border-white/20">
            <User size={20} />
          </div>
          <div className="flex flex-col">
            <h1 className="text-sm font-bold leading-none mb-0.5">Bluesky タイムライン</h1>
            <div className="flex items-center">
              <div className="w-1.5 h-1.5 bg-green-400 rounded-full mr-1 animate-pulse"></div>
              <p className="text-[10px] opacity-80">オンライン</p>
            </div>
          </div>
        </div>
        <div className="flex items-center space-x-2">
          <button onClick={fetchTimeline} className="p-2 hover:bg-white/10 rounded-full transition-colors active:scale-90">
            <RefreshCw size={20} className={refreshing ? "animate-spin" : ""} />
          </button>
        </div>
      </header>

      {/* Message List */}
      <div 
        ref={scrollRef}
        className="flex-1 overflow-y-auto p-4 space-y-4 scroll-smooth"
        style={{ backgroundImage: 'linear-gradient(to bottom, transparent, rgba(0,0,0,0.02))' }}
      >
        {feed.map((msg, idx) => (
          <div 
            key={msg.id + idx} 
            className={`flex ${msg.isMe ? 'flex-row-reverse space-x-reverse' : 'flex-row'} items-end space-x-2 animate-in fade-in slide-in-from-bottom-2 duration-300`}
          >
            {!msg.isMe && (
              <img 
                src={msg.avatar || `https://ui-avatars.com/api/?name=${msg.author}&background=random`} 
                className="w-10 h-10 rounded-2xl bg-white mb-4 shadow-sm border border-black/5" 
                alt="avatar"
              />
            )}
            
            <div className={`flex flex-col ${msg.isMe ? 'items-end' : 'items-start'}`}>
              {!msg.isMe && (
                <span className="text-[11px] text-white ml-1 mb-1 font-bold drop-shadow-sm">{msg.author}</span>
              )}
              
              <div className="flex items-end space-x-1.5 space-x-reverse">
                <div className={`max-w-[260px] px-3.5 py-2.5 rounded-[18px] text-[15px] shadow-sm relative
                  ${msg.isMe 
                    ? 'bg-[#8DE055] text-black rounded-tr-none' 
                    : 'bg-white text-black rounded-tl-none'}
                `}>
                  <p className="whitespace-pre-wrap break-words leading-snug">{msg.text}</p>
                </div>
                
                <span className="text-[9px] text-white/80 font-medium mb-1 whitespace-nowrap">
                  {new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                </span>
              </div>
            </div>
          </div>
        ))}
        {feed.length === 0 && !refreshing && (
          <div className="flex flex-col items-center justify-center mt-20 space-y-3 opacity-40">
            <div className="w-16 h-16 rounded-full border-2 border-white/50 border-dashed flex items-center justify-center text-white">
              <RefreshCw size={32} />
            </div>
            <p className="text-white text-sm font-medium">投稿を読み込んでいます</p>
          </div>
        )}
      </div>

      {/* Input Area */}
      <div className="bg-white p-3 pb-8 border-t border-gray-100">
        <form onSubmit={handleSendMessage} className="flex items-end space-x-2">
          <div className="flex-1 bg-[#F5F5F5] rounded-3xl px-4 py-2 flex items-center min-h-[44px]">
            <textarea
              rows="1"
              className="flex-1 bg-transparent border-none focus:ring-0 text-[15px] resize-none max-h-32 text-black outline-none py-1"
              placeholder="メッセージを入力"
              value={inputText}
              onChange={(e) => {
                setInputText(e.target.value);
                // Simple auto-resize logic
                e.target.style.height = 'auto';
                e.target.style.height = e.target.scrollHeight + 'px';
              }}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                  e.preventDefault();
                  handleSendMessage(e);
                }
              }}
            />
          </div>
          <button 
            type="submit" 
            disabled={!inputText.trim()}
            className={`p-2 transition-all active:scale-90 ${inputText.trim() ? 'text-[#00C300]' : 'text-gray-300'}`}
          >
            <Send size={28} />
          </button>
        </form>
      </div>
    </div>
  );
}